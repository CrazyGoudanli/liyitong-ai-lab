# 复制成 .env 再填。.env 不要提交到仓库。

# 火山方舟的 API Key（控制台 → API Key 管理）
ARK_API_KEY=

# 模型 ID 或推理接入点 ID。要能看图（第四场拍台词）就选支持图片输入的模型。
# 演示讲究快，建议选响应快的版本。
ARK_MODEL=doubao-seed-2-1-pro-260915

# 一般不用改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 可选：额外请求参数（JSON），例如关闭深度思考让回复更快。先确认你选的模型支持再开。
# ARK_EXTRA={"thinking":{"type":"disabled"}}

# 访问码：她第一次打开时输入一次。留空则任何人拿到链接都能用。
ACCESS_CODE=

PORT=8787
